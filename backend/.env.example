# Local development (no AWS needed): in-memory store + demo students
PORT=4000
DATA_STORE=memory
SEED_DEMO=true
CORS_ORIGIN=http://localhost:5173

# Deployed Lambda environment variables (set in the Lambda console, NOT in code)
# DATA_STORE=dynamodb
# TABLE_NAME=<your-dynamodb-table-name>
# SNS_TOPIC_ARN=<optional: arn of your SNS topic>
# ALLOWED_ORIGIN=<optional: only if API Gateway CORS is not configured>
