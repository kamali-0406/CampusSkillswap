# Copy to .env.local and fill in AFTER you create the AWS resources. Never put secret keys here.
# These values are public identifiers (they ship in the browser bundle) - that is expected for Cognito.

VITE_AWS_REGION=<your-aws-region>
VITE_COGNITO_USER_POOL_ID=<your-user-pool-id>
VITE_COGNITO_CLIENT_ID=<your-app-client-id>

# Invoke URL of your API Gateway HTTP API (no trailing slash)
VITE_API_BASE_URL=<your-api-gateway-invoke-url>

# Optional. Leave unset: the app uses Cognito when the pool values above are present,
# and the local demo auth (backend/local-server) when running `npm run dev` without them.
# VITE_AUTH_MODE=cognito
