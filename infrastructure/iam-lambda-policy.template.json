{
  "_comment": "TEMPLATE ONLY. Replace every <PLACEHOLDER> with your own values when you create the policy. Nothing here exists yet.",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamoDbAccessToSkillSwapTableOnly",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:DeleteItem", "dynamodb:Query", "dynamodb:Scan"],
      "Resource": [
        "arn:aws:dynamodb:<REGION>:<ACCOUNT_ID>:table/<TABLE_NAME>",
        "arn:aws:dynamodb:<REGION>:<ACCOUNT_ID>:table/<TABLE_NAME>/index/*"
      ]
    },
    {
      "Sid": "PublishToNotificationTopic",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:<REGION>:<ACCOUNT_ID>:<TOPIC_NAME>"
    }
  ]
}
